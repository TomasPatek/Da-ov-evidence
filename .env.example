# Kopie tohoto souboru se jmenuje .env a NIKDY se necommituje. Popis: docs/konfigurace.md

# Tajný klíč pro přihlašovací cookie. Vygenerujte: openssl rand -base64 48
SECRET_KEY=

# Aplikace běží v lokální síti přes http://, proto false. true jen pokud před ni
# sami postavíte HTTPS v lokální síti.
COOKIE_SECURE=false

# Port aplikace na serveru.
APP_PORT=8000

# Uživatel a skupina, pod kterými kontejner běží (vlastník složek data a config).
APP_UID=1000
APP_GID=1000

LOG_LEVEL=INFO

# Volitelně pevný kód pro první spuštění (jinak se vygeneruje a vypíše do logu).
SETUP_TOKEN=

# Odesílání faktur e-mailem. Příklad pro WEDOS je v docs/konfigurace.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Adresa odesílatele; prázdné = SMTP_USER.
SMTP_FROM=

# Stahování notifikací banky a dokladů ze schránky. Příklad pro WEDOS je v docs/konfigurace.md.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Jak často stahovat poštu (minuty); 0 = jen tlačítkem v aplikaci.
POSTA_INTERVAL_MIN=15

# Noční šifrovaná záloha (restic). Postup: docs/zalohovani.md
# Úložiště, např. rclone:zaloha:danova-evidence (cloud přes rclone) nebo /zaloha (složka).
BACKUP_REPOSITORY=
# Heslo zálohy. Bez něj zálohu nikdo neobnoví: uložte ho i mimo server.
RESTIC_PASSWORD=
# Kdy zálohovat (HH:MM).
BACKUP_TIME=02:30

