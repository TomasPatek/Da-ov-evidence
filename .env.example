# Kopie tohoto souboru se jmenuje .env a NIKDY se necommituje. Popis: docs/konfigurace.md

# Tajný klíč pro přihlašovací cookie. Vygenerujte: openssl rand -base64 48
SECRET_KEY=

# true = cookie jen přes HTTPS (s reverzní proxy). Bez proxy (http://) nastavte false.
COOKIE_SECURE=true

# Port aplikace na serveru.
APP_PORT=8000

# Uživatel a skupina, pod kterými kontejner běží (vlastník složek data a config).
APP_UID=1000
APP_GID=1000

LOG_LEVEL=INFO

# IP adresy proxy, jejichž hlavičkám X-Forwarded-For se věří. S Caddy v compose: *
FORWARDED_ALLOW_IPS=127.0.0.1

# Volitelně pevný kód pro první spuštění (jinak se vygeneruje a vypíše do logu).
SETUP_TOKEN=

# Pošta (používá se od fáze 1 a 3).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Reverzní proxy Caddy (jen s --profile proxy).
DOMAIN=ucetnictvi.example.cz
ACME_EMAIL=
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=
